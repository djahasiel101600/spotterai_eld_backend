# Django Configuration
# IMPORTANT: Generate a new secret key for production using:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here-generate-new-one

# Debug mode - set to False in production
DEBUG=False

# Allowed hosts - add your domain(s) in production
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com

# CORS Configuration
# List allowed origins for CORS (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Only set to True for local development, never in production
CORS_ALLOW_ALL_ORIGINS=False

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key

# Database Configuration (Production)
DB_NAME=eld_database
DB_USER=eld_user
DB_PASSWORD=your-secure-db-password
DB_HOST=localhost
DB_PORT=5432

# Security Settings (Production)
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# Logging
DJANGO_LOG_LEVEL=INFO
ELD_LOG_LEVEL=INFO